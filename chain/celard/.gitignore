# celard (Cosmos SDK / Cosmos EVM app) — local build & node state
# Repo-wide ignores (OS noise, secrets, backups) live in the root .gitignore.

# Go build artifacts
/celard
*.exe
*.test
*.out
coverage.txt
profile.out

# Local node / devnet home data — never commit chain state
.evmd/
.celard/
.testnets/
node[0-9]*/
data/
*.db

# Validator & node secrets — MUST never be committed
priv_validator_key.json
priv_validator_state.json
node_key.json
*.mnemonic
*.seed

# Editor / IDE
.vscode/
.idea/
*.swp
